        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "MinuteRange",
      "type": "object"
    },
    "PriceGraph": {
      "additionalProperties": false,
      "description": "Google's price graph for one trip length (null on a one-way): its\nestimate for each date pair, with no itinerary behind it.",
      "properties": {
        "trip_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trip Length"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/PriceGraphCell"
