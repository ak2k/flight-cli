      "required": [
        "cabin",
        "origins",
        "destinations",
        "currency",
        "price",
        "duration_minutes",
        "layover_minutes",
        "airlines",
        "alliances",
        "connecting_airports"
      ],
      "title": "RouteFacets",
      "type": "object"
    },
