          "type": "array"
        }
      },
      "required": [
        "trip_length",
        "currency",
        "cells"
      ],
      "title": "PriceGraph",
      "type": "object"
    },
    "PriceGraphCell": {
      "additionalProperties": false,
      "description": "One date pair of Google's price graph; `return` is null on a one-way.",
      "properties": {
        "departure": {
          "format": "date",
          "title": "Departure",
          "type": "string"
        },
        "return": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Return"
        },
        "price": {
          "title": "Price",
          "type": "number"
        }
      },
      "required": [
        "departure",
        "return",
        "price"
      ],
      "title": "PriceGraphCell",
      "type": "object"
    },
