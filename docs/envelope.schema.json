    "ResultRow": {
      "additionalProperties": false,
      "description": "One itinerary, priced day or graph cell. `row` is the object `--format\njson` prints for it, unchanged; `price` is the trip's price, a round trip's\nbeing its last member's.",
      "properties": {
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "row": {
          "title": "Row"
        }
      },
      "required": [
        "price",
        "currency",
        "row"
      ],
      "title": "ResultRow",
      "type": "object"
    },
    "RouteFacets": {
      "additionalProperties": false,
      "description": "The filter choices Google's page states for one cabin's search, labeled\nwith its airports: its fare range in the rows' basis and currency, its\ntrip-length and layover ranges, and the alliances, airlines and connecting\nairports its filters offer, in the page's order. An alliance's code is\nspelled as `--extension 'ALLIANCE \u2026'` takes it.",
      "properties": {
        "cabin": {
          "title": "Cabin",
          "type": "string"
        },
        "origins": {
          "items": {
            "type": "string"
          },
          "title": "Origins",
          "type": "array"
        },
        "destinations": {
          "items": {
            "type": "string"
          },
          "title": "Destinations",
          "type": "array"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "price": {
          "$ref": "#/$defs/PriceRange"
        },
        "duration_minutes": {
          "$ref": "#/$defs/MinuteRange"
        },
        "layover_minutes": {
          "$ref": "#/$defs/MinuteRange"
        },
        "airlines": {
          "items": {
            "$ref": "#/$defs/CodeName"
          },
          "title": "Airlines",
          "type": "array"
        },
        "alliances": {
          "items": {
            "$ref": "#/$defs/CodeName"
          },
          "title": "Alliances",
          "type": "array"
        },
        "connecting_airports": {
          "items": {
            "$ref": "#/$defs/ConnectingAirport"
          },
          "title": "Connecting Airports",
          "type": "array"
        }
