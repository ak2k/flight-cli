    "Insight": {
      "additionalProperties": false,
      "description": "Google's price insight for one cabin's page.",
      "properties": {
        "cabin": {
          "title": "Cabin",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "cheapest": {
          "title": "Cheapest",
          "type": "number"
        },
        "typical_low": {
          "title": "Typical Low",
          "type": "number"
        },
        "typical_high": {
          "title": "Typical High",
          "type": "number"
        },
        "level": {
          "enum": [
            "low",
            "typical",
            "high"
          ],
